# ============================================================
# HTTP SESSION
# ============================================================

def build_http_session() -> requests.Session:
    """
    Create a requests session with retry handling.
    """

    retry = Retry(
        total=5,
        connect=5,
        read=5,
        backoff_factor=2,
        status_forcelist=[
            429,
            500,
            502,
            503,
            504,
        ],
        allowed_methods={"GET"},
    )

    adapter = HTTPAdapter(
        max_retries=retry
    )

    session = requests.Session()

    session.mount(
        "https://",
        adapter,
    )

    return session


# ============================================================
# 1. DOWNLOAD PUB LOG
# ============================================================

def download_publog(
    destination: Path,
) -> dict:
    """
    Download the current PUB LOG ZIP and calculate SHA-256.
    """

    print("\nDownloading current PUB LOG...")

    session = build_http_session()

    sha256 = hashlib.sha256()
    bytes_downloaded = 0

    with session.get(
        PUBLOG_URL,
        stream=True,
        timeout=(30, 300),
    ) as response:

        response.raise_for_status()

        content_length = response.headers.get(
            "Content-Length"
        )

        total_bytes = (
            int(content_length)
            if content_length
            else None
        )

        with (
            destination.open("wb") as file,
            tqdm(
                total=total_bytes,
                desc="Downloading PUB LOG",
                unit="B",
                unit_scale=True,
                unit_divisor=1024,
            ) as progress,
        ):

            for chunk in response.iter_content(
                chunk_size=1024 * 1024
            ):
                if not chunk:
                    continue

                file.write(chunk)

                sha256.update(chunk)

                bytes_downloaded += len(chunk)

                progress.update(
                    len(chunk)
                )

    if not zipfile.is_zipfile(destination):
        raise RuntimeError(
            "Downloaded PUB LOG file "
            "is not a valid ZIP archive."
        )

    size_mb = (
        bytes_downloaded
        / (1024 * 1024)
    )

    print(
        f"ZIP verified: {size_mb:,.1f} MB"
    )

    return {
        "url": PUBLOG_URL,
        "bytes": bytes_downloaded,
        "sha256": sha256.hexdigest(),
    }


# ============================================================
# 2. EXTRACT PUB LOG
# ============================================================

def extract_publog(
    zip_path: Path,
    destination: Path,
) -> Path:
    """
    Extract the downloaded PUB LOG package.
    """

    print("\nExtracting PUB LOG...")

    destination.mkdir(
        parents=True,
        exist_ok=True,
    )

    with zipfile.ZipFile(
        zip_path,
        "r",
    ) as archive:

        members = archive.infolist()

        with tqdm(
            total=len(members),
            desc="Extracting PUB LOG",
            unit="file",
        ) as progress:

            for member in members:
                archive.extract(
                    member,
                    destination,
                )

                progress.update(1)

    imd_lst = (
        destination
        / "IMD.LST"
    )

    decomp = (
        destination
        / "TOOLS"
        / "UTILITIES"
        / "Decomp.exe"
    )

    if not imd_lst.exists():
        raise FileNotFoundError(
            f"IMD.LST was not found:\n"
            f"{imd_lst}"
        )

    if not decomp.exists():
        raise FileNotFoundError(
            f"Decomp.exe was not found:\n"
            f"{decomp}"
        )

    print("PUB LOG extraction complete.")

    return destination


# ============================================================
# DECOMP HELPERS
# ============================================================

def get_decomp_path(
    publog_dir: Path,
) -> Path:

    return (
        publog_dir
        / "TOOLS"
        / "UTILITIES"
        / "Decomp.exe"
    )


def run_decomp(
    publog_dir: Path,
    sql: str,
    output_file: Path,
    show_wait: bool = False,
    label: str = "DECOMP",
) -> None:
    """
    Execute a PUB LOG SQL query through Decomp.exe.

    Important:
    Decomp.exe does not appear to use the conventional
    process return code of 0 = success.

    Success is therefore determined by whether DECOMP
    actually creates a valid output file.
    """

    output_file.parent.mkdir(
        parents=True,
        exist_ok=True,
    )

    # Prevent an old file from being mistaken
    # for successful new output.
    output_file.unlink(
        missing_ok=True
    )

    command = [
        str(get_decomp_path(publog_dir)),
        str(publog_dir),
        sql,
        str(output_file),
    ]

    start_time = time.perf_counter()

    process = subprocess.Popen(
        command,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        encoding=DECOMP_ENCODING,
        errors="replace",
    )

    if show_wait:

        # DECOMP does not expose percentage progress,
        # so display elapsed time instead.
        with tqdm(
            total=None,
            desc=label,
            unit="s",
            bar_format="{desc}: {elapsed}",
        ) as progress:

            while process.poll() is None:
                time.sleep(1)
                progress.update(1)

    stdout, stderr = (
        process.communicate()
    )

    elapsed = (
        time.perf_counter()
        - start_time
    )

    if not output_file.exists():

        raise RuntimeError(
            "\nDECOMP failed to create "
            "an output file.\n\n"
            f"SQL:\n{sql}\n\n"
            f"Process return code: "
            f"{process.returncode}\n\n"
            f"STDOUT:\n{stdout}\n\n"
            f"STDERR:\n{stderr}"
        )

    if output_file.stat().st_size == 0:

        raise RuntimeError(
            "\nDECOMP created an empty "
            "output file.\n\n"
            f"SQL:\n{sql}\n\n"
            f"Process return code: "
            f"{process.returncode}\n\n"
            f"STDOUT:\n{stdout}\n\n"
            f"STDERR:\n{stderr}"
        )

    if show_wait:
        print(
            f"  DECOMP completed "
            f"in {elapsed:,.1f} seconds."
        )


