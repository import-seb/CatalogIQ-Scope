def parse_integer(
    value: str | None,
) -> int | None:
    """
    Convert DLA row counts to Python integers.
    """

    if value is None:
        return None

    digits = re.sub(
        r"[^\d]",
        "",
        value,
    )

    if not digits:
        return None

    return int(digits)


def get_table_metadata(
    publog_dir: Path,
    table_name: str,
    temp_dir: Path,
) -> dict:
    """
    Query DLA's built-in IMD_TABLES table.
    """

    output_file = (
        temp_dir
        / f"metadata_{table_name}.txt"
    )

    sql = (
        "select TABLE_NAME,ROWS,PUB_DATE "
        "from IMD_TABLES "
        f"where TABLE_NAME='{table_name}'"
    )

    run_decomp(
        publog_dir=publog_dir,
        sql=sql,
        output_file=output_file,
        show_wait=False,
    )

    with output_file.open(
        "r",
        encoding=DECOMP_ENCODING,
        errors="replace",
        newline="",
    ) as file:

        reader = csv.DictReader(
            file,
            delimiter="|",
        )

        rows = list(reader)

    if not rows:

        raise RuntimeError(
            f"IMD_TABLES returned no "
            f"metadata for {table_name}"
        )

    row = {}

    for key, value in rows[0].items():

        if key is None:
            continue

        clean_key = str(
            key
        ).strip()

        clean_value = (
            str(value).strip()
            if value is not None
            else ""
        )

        row[clean_key] = clean_value

    return {
        "table": row.get(
            "TABLE_NAME",
            table_name,
        ),

        "rows": parse_integer(
            row.get("ROWS")
        ),

        "pub_date": row.get(
            "PUB_DATE",
            "",
        ),
    }


def get_all_metadata(
    publog_dir: Path,
    temp_dir: Path,
) -> dict:
    """
    Read publication metadata for every table we use.
    """

    print(
        "\nReading PUB LOG metadata..."
    )

    metadata = {}

    for table_name in TABLES:

        info = get_table_metadata(
            publog_dir,
            table_name,
            temp_dir,
        )

        metadata[
            table_name
        ] = info

        row_count = info["rows"]

        if row_count is None:
            row_display = "unknown"
        else:
            row_display = (
                f"{row_count:,}"
            )

        print(
            f"  {table_name}: "
            f"{row_display} rows | "
            f"PUB_DATE={info['pub_date']}"
        )

    return metadata


# ============================================================
# CURRENT RELEASE
# ============================================================

def load_current_manifest(
) -> dict | None:
    """
    Load the manifest belonging to CURRENT.json.
    """

    if not CURRENT_POINTER.exists():
        return None

    try:

        with CURRENT_POINTER.open(
            "r",
            encoding="utf-8",
        ) as file:

            pointer = json.load(file)

        manifest_relative = pointer.get(
            "manifest"
        )

        if not manifest_relative:
            return None

        manifest_path = (
            PROJECT_ROOT
            / Path(manifest_relative)
        )

        if not manifest_path.exists():
            return None

        with manifest_path.open(
            "r",
            encoding="utf-8",
        ) as file:

            return json.load(file)

    except (
        json.JSONDecodeError,
        OSError,
    ):
        return None


def metadata_changed(
    current_metadata: dict,
) -> bool:
    """
    Compare the newest DLA metadata with the
    currently published local release.
    """

    previous = (
        load_current_manifest()
    )

    if previous is None:
        print(
            "\nNo existing release found."
        )
        return True

    previous_metadata = (
        previous.get(
            "source_tables",
            {},
        )
    )

    if (
        previous_metadata
        == current_metadata
    ):
        return False

    return True


# ============================================================
# RELEASE ID
# ============================================================

def make_release_id(
    metadata: dict,
) -> str:
    """
    Create a readable directory name from PUB_DATE.
    """

    pub_dates = [
        info["pub_date"]
        for info in metadata.values()
        if info.get("pub_date")
    ]

    if pub_dates:

        # Usually all tables have the same publication
        # date. If not, choose the most common date.
        source_date = max(
            set(pub_dates),
            key=pub_dates.count,
        )

    else:

        source_date = (
            datetime.now(
                timezone.utc
            ).strftime(
                "%Y-%m-%d"
            )
        )

    clean = re.sub(
        r"[^0-9A-Za-z]+",
        "-",
        source_date,
    ).strip("-")

    return clean


# ============================================================
# 3. EXPORT A PUB LOG TABLE
# ============================================================

def export_table(
    publog_dir: Path,
    table_name: str,
    config: dict,
    raw_dir: Path,
) -> Path:
    """
    Export a complete PUB LOG table using Decomp.exe.
    """

    fields = ",".join(
        config["fields"]
    )

    primary_key = (
        config["key"]
    )

    sql = (
        f"select {fields} "
        f"from {table_name} "
        f"where {primary_key}='*'"
    )

    output_file = (
        raw_dir
        / f"{table_name}.pipe"
    )

    print(
        f"\nExporting {table_name}..."
    )

    run_decomp(
        publog_dir=publog_dir,
        sql=sql,
        output_file=output_file,
        show_wait=True,
        label=f"DECOMP {table_name}",
    )

    size_mb = (
        output_file.stat().st_size
        / (1024 * 1024)
    )

    print(
        f"  Raw export size: "
        f"{size_mb:,.1f} MB"
    )

    return output_file


# ============================================================
# 4. STREAM PIPE FILE -> PARQUET
# ============================================================

def pipe_to_parquet(
    pipe_file: Path,
    parquet_dir: Path,
    required_columns: list[str],
    table_name: str,
    expected_rows: int | None,
) -> int:
    """
    Read the huge pipe-delimited export in chunks
    and write partitioned Parquet files.

    The complete table is never loaded into RAM.
    """

    parquet_dir.mkdir(
        parents=True,
        exist_ok=True,
    )

    total_rows = 0
    part_number = 0

    reader = pd.read_csv(
        pipe_file,
        sep="|",
        dtype=str,
        chunksize=CHUNK_SIZE,
        encoding=DECOMP_ENCODING,
        keep_default_na=False,
        on_bad_lines="error",
    )

    with tqdm(
        total=expected_rows or None,
        desc=f"Transforming {table_name}",
        unit="rows",
        unit_scale=True,
    ) as progress:

        for chunk in reader:

            # Clean column names.
            chunk.columns = [
                str(column).strip()
                for column
                in chunk.columns
            ]

            missing_columns = (
                set(required_columns)
                - set(chunk.columns)
            )

            if missing_columns:

                raise RuntimeError(
                    f"{pipe_file.name} "
                    f"is missing expected "
                    f"columns: "
                    f"{sorted(missing_columns)}"
                )

            # Ignore any unexpected columns
            # and preserve our desired order.
            chunk = chunk[
                required_columns
            ].copy()

            # PUB LOG text fields may contain
            # fixed-width padding.
            for column in chunk.columns:

                chunk[column] = (
                    chunk[column]
                    .astype("string")
                    .str.strip()
                )

            rows = len(chunk)

            part_path = (
                parquet_dir
                / (
                    f"part-"
                    f"{part_number:05d}"
                    f".parquet"
                )
            )

            chunk.to_parquet(
                part_path,
                engine="pyarrow",
                compression="zstd",
                index=False,
            )

            total_rows += rows
            part_number += 1

            progress.update(rows)

    print(
        f"  {table_name}: "
        f"{total_rows:,} rows transformed."
    )

    return total_rows


# ============================================================
# VALIDATION
# ============================================================

def validate_row_count(
    table_name: str,
    actual_rows: int,
    expected_rows: int | None,
) -> None:
    """
    Compare our exported row count with DLA's
    IMD_TABLES metadata.
    """

    if expected_rows is None:

        print(
            f"  WARNING: No DLA row count "
            f"available for {table_name}."
        )

        return

    if actual_rows == expected_rows:

        print(
            f"  Row count validated: "
            f"{actual_rows:,}"
        )

        return

    message = (
        f"{table_name}: "
        f"exported {actual_rows:,} rows, "
        f"but DLA IMD_TABLES reports "
        f"{expected_rows:,} rows."
    )

    if STRICT_ROW_COUNT:
        raise RuntimeError(
            message
        )

    print(
        f"  WARNING: {message}"
    )


# ============================================================
# BUILD NEW RELEASE
# ============================================================

def build_release(
    publog_dir: Path,
    metadata: dict,
    download_info: dict,
    release_dir: Path,
) -> dict:
    """
    Export, transform, and validate every required table.
    """

    raw_dir = (
        release_dir
        / "_raw"
    )

    parquet_root = (
        release_dir
        / "parquet"
    )

    raw_dir.mkdir(
        parents=True,
        exist_ok=True,
    )

    parquet_root.mkdir(
        parents=True,
        exist_ok=True,
    )

    table_results = {}

    total_tables = len(TABLES)

    for number, (
        table_name,
        config,
    ) in enumerate(
        TABLES.items(),
        start=1,
    ):

        print(
            "\n"
            + "=" * 60
        )

        print(
            f"TABLE {number}/{total_tables}: "
            f"{table_name}"
        )

        print(
            "=" * 60
        )

        expected_rows = (
            metadata[
                table_name
            ]["rows"]
        )

        # ----------------------------
        # Export
        # ----------------------------

        pipe_file = export_table(
            publog_dir,
            table_name,
            config,
            raw_dir,
        )

        # ----------------------------
        # Transform
        # ----------------------------

        parquet_dir = (
            parquet_root
            / table_name.lower()
        )

        actual_rows = (
            pipe_to_parquet(
                pipe_file=pipe_file,
                parquet_dir=parquet_dir,
                required_columns=config[
                    "fields"
                ],
                table_name=table_name,
                expected_rows=expected_rows,
            )
        )

        # ----------------------------
        # Validate
        # ----------------------------

        validate_row_count(
            table_name=table_name,
            actual_rows=actual_rows,
            expected_rows=expected_rows,
        )

        table_results[
            table_name
        ] = {
            "rows": actual_rows,

            "path": (
                parquet_dir
                .relative_to(
                    PROJECT_ROOT
                )
                .as_posix()
            ),
        }

        # Parquet is now validated.
        # Delete enormous temporary pipe file.
        pipe_file.unlink(
            missing_ok=True
        )

    # Raw directory should now be empty.
    shutil.rmtree(
        raw_dir,
        ignore_errors=True,
    )

    manifest = {
        "created_at_utc": (
            datetime.now(
                timezone.utc
            ).isoformat()
        ),

        "source": (
            "Defense Logistics Agency "
            "PUB LOG"
        ),

        "download": (
            download_info
        ),

        "source_tables": (
            metadata
        ),

        "parquet_tables": (
            table_results
        ),
    }

    manifest_path = (
        release_dir
        / "manifest.json"
    )

    with manifest_path.open(
        "w",
        encoding="utf-8",
    ) as file:

        json.dump(
            manifest,
            file,
            indent=2,
        )

    return manifest


# ============================================================
# ATOMIC RELEASE SWITCH
# ============================================================

def publish_release(
    release_dir: Path,
) -> None:
    """
    Atomically update CURRENT.json only after the
    complete release has successfully finished.
    """

    manifest_path = (
        release_dir
        / "manifest.json"
    )

    pointer = {
        "release": (
            release_dir.name
        ),

        "manifest": (
            manifest_path
            .relative_to(
                PROJECT_ROOT
            )
            .as_posix()
        ),
    }

    DATA_DIR.mkdir(
        parents=True,
        exist_ok=True,
    )

    temp_pointer = (
        CURRENT_POINTER
        .with_suffix(
            ".json.tmp"
        )
    )

    with temp_pointer.open(
        "w",
        encoding="utf-8",
    ) as file:

        json.dump(
            pointer,
            file,
            indent=2,
        )

    # os.replace is atomic when source and
    # destination are on the same filesystem.
    os.replace(
        temp_pointer,
        CURRENT_POINTER,
    )

    print(
        "\n"
        + "=" * 60
    )

    print(
        f"CURRENT release -> "
        f"{release_dir.name}"
    )

    print(
        "=" * 60
    )


