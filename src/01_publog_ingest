# MAIN
# ============================================================

def main() -> None:

    print(
        "=" * 60
    )

    print(
        "DLA PUB LOG MONTHLY INGEST"
    )

    print(
        "=" * 60
    )

    DATA_DIR.mkdir(
        parents=True,
        exist_ok=True,
    )

    RELEASES_DIR.mkdir(
        parents=True,
        exist_ok=True,
    )

    CACHE_DIR.mkdir(
        parents=True,
        exist_ok=True,
    )

    # Everything inside this directory is temporary:
    # downloaded ZIP, extracted PUB LOG application, etc.
    with tempfile.TemporaryDirectory(
        prefix="publog_",
        dir=CACHE_DIR,
    ) as temp_name:

        temp_dir = Path(
            temp_name
        )

        zip_path = (
            temp_dir
            / "PublogDVD.zip"
        )

        publog_dir = (
            temp_dir
            / "publog"
        )

        # ====================================================
        # DOWNLOAD
        # ====================================================

        download_info = (
            download_publog(
                zip_path
            )
        )

        # ====================================================
        # EXTRACT
        # ====================================================

        extract_publog(
            zip_path,
            publog_dir,
        )

        # ====================================================
        # CHECK DLA PUBLICATION METADATA
        # ====================================================

        metadata = (
            get_all_metadata(
                publog_dir,
                temp_dir,
            )
        )

        if not metadata_changed(
            metadata
        ):

            print(
                "\nPUB LOG has not changed."
            )

            print(
                "Current dataset remains active."
            )

            return

        print(
            "\nNew PUB LOG release detected."
        )

        # ====================================================
        # CREATE RELEASE NAME
        # ====================================================

        release_id = (
            make_release_id(
                metadata
            )
        )

        final_release_dir = (
            RELEASES_DIR
            / release_id
        )

        # Avoid overwriting an existing release.
        if final_release_dir.exists():

            release_id = (
                release_id
                + "-"
                + datetime.now()
                .strftime(
                    "%Y%m%d-%H%M%S"
                )
            )

            final_release_dir = (
                RELEASES_DIR
                / release_id
            )

        # ====================================================
        # STAGING
        # ====================================================

        staging_dir = (
            RELEASES_DIR
            / (
                f".staging-"
                f"{release_id}"
            )
        )

        if staging_dir.exists():

            shutil.rmtree(
                staging_dir
            )

        staging_dir.mkdir(
            parents=True
        )

        try:

            print(
                f"\nBuilding release: "
                f"{release_id}"
            )

            # Build everything without affecting CURRENT.
            build_release(
                publog_dir=publog_dir,
                metadata=metadata,
                download_info=download_info,
                release_dir=staging_dir,
            )

            # All seven tables succeeded.
            # Move staged data into its permanent directory.
            staging_dir.rename(
                final_release_dir
            )

            # Only now switch CURRENT.
            publish_release(
                final_release_dir
            )

        except Exception:

            print(
                "\nRelease failed."
            )

            print(
                "Existing CURRENT dataset "
                "was NOT changed."
            )

            shutil.rmtree(
                staging_dir,
                ignore_errors=True,
            )

            raise

    print(
        "\n"
        + "=" * 60
    )

    print(
        "PUB LOG UPDATE COMPLETE"
    )

    print(
        "=" * 60
    )


if __name__ == "__main__":
    main()